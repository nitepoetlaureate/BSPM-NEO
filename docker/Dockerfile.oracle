# docker/Dockerfile.oracle - Frontend & Design Sandbox (ARM)
FROM ghcr.io/astral-sh/uv:python3.11-bookworm-slim

WORKDIR /app

# Enable bytecode compilation
ENV UV_COMPILE_BYTECODE=1

# Copy dependency files first for caching
COPY tools/unified-backend/pyproject.toml tools/unified-backend/uv.lock ./

# Install dependencies using uv
RUN uv sync --frozen --no-dev

# Copy the application
COPY tools/unified-backend/backend ./backend
COPY .claude ./.claude
COPY design ./design

# Expose FastAPI port
EXPOSE 8000

# Run the application
CMD ["uv", "run", "python", "-m", "uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
